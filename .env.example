# Get a key at https://console.typesafe.ai/settings/keys and copy this file to
# .env. Every example reads the repository root's .env, and the `bel` command
# reads the .env in the directory it runs from.
TYPESAFE_API_KEY=

# Both optional.
# BEL_MODEL=jev-latest
# BEL_API_URL=https://api.typesafe.ai/v1/systemone

# Set to 1 to record a test.snapshot instead of replaying it.
# BEL_RECORD=1
